<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Commercial Pricing & Valuation Dynamic Model</title>
  <!-- Tailwind CSS & Chart.js CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            },
            dark: {
              800: '#1e293b',
              850: '#131d2e',
              900: '#0f172a',
              950: '#080c14',
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    input[type=range] { accent-color: #0ea5e9; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    /* ==========================================================================
       EXECUTIVE 1-PAGE PDF PROPOSAL PRINT ENGINE (@media print)
       ========================================================================== */
    @media print {
      @page {
        size: A4 portrait;
        margin: 6mm 8mm 6mm 8mm;
      }
      *, *::before, *::after {
        box-shadow: none !important;
        text-shadow: none !important;
      }
      html, body {
        background-color: #080c14 !important;
        color: #ffffff !important;
        font-size: 8.5pt !important;
        line-height: 1.25 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      /* Hide interactive navigation controls and secondary tabs */
      header, aside, footer, .no-print,
      #pane-pnl, #pane-ratecard, #pane-montecarlo,
      #chartBreakEven, #chartCostStructure {
        display: none !important;
      }

      /* Reset Layout Constraints */
      .max-w-\[1600px\], main, #pane-dashboard {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
      }

      /* Header Block */
      #print-executive-header {
        display: flex !important;
        justify-content: space-between !important;
        align-items: flex-start !important;
        border-bottom: 2px solid #0284c7 !important;
        padding-bottom: 6px !important;
        margin-bottom: 10px !important;
      }

      /* KPI Cards Grid */
      .print-kpi-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 6px !important;
        margin-bottom: 10px !important;
      }
      .print-kpi-card {
        border: 1px solid #1e293b !important;
        background-color: #0f172a !important;
        border-radius: 6px !important;
        padding: 6px 8px !important;
      }
      .print-kpi-card span {
        color: #94a3b8 !important;
        font-size: 7pt !important;
      }
      .print-kpi-card .val {
        color: #ffffff !important;
        font-size: 11.5pt !important;
        font-weight: 800 !important;
        font-family: 'JetBrains Mono', monospace !important;
      }

      /* Cost Pool Table in Print */
      #table-cost-container {
        border: 1px solid #1e293b !important;
        background-color: #0f172a !important;
        border-radius: 6px !important;
        margin-bottom: 10px !important;
        overflow: hidden !important;
      }
      table {
        width: 100% !important;
        border-collapse: collapse !important;
        font-size: 7.8pt !important;
      }
      thead th {
        background-color: #131d2e !important;
        color: #38bdf8 !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        border-bottom: 1.5px solid #1e293b !important;
        padding: 5px 8px !important;
      }
      tbody td {
        border-bottom: 1px solid #1e293b !important;
        color: #ffffff !important;
        padding: 4.5px 8px !important;
      }
      .table-text-main {
        color: #ffffff !important;
        font-weight: 600 !important;
      }
      .table-val-bold {
        color: #ffffff !important;
        font-weight: 700 !important;
      }
      .table-val-accent {
        color: #38bdf8 !important;
        font-weight: 600 !important;
      }
      .table-val-muted {
        color: #cbd5e1 !important;
      }
      .badge-print {
        background-color: #1e293b !important;
        color: #e2e8f0 !important;
        border: 1px solid #334155 !important;
        padding: 1px 4px !important;
        border-radius: 3px !important;
        font-size: 6.5pt !important;
      }

      /* Commercial Rate Card Options Grid */
      #print-commercial-options {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 6px !important;
        margin-bottom: 10px !important;
      }
      .print-rate-box {
        border: 1px solid #1e293b !important;
        background-color: #0f172a !important;
        border-radius: 6px !important;
        padding: 7px !important;
      }
      .print-rate-box b {
        color: #ffffff !important;
      }
      .print-rate-box span {
        color: #94a3b8 !important;
      }

      /* Sign-off Section */
      #print-signoff-block {
        display: flex !important;
        justify-content: space-between !important;
        margin-top: 10px !important;
        padding-top: 8px !important;
        border-top: 1px dashed #334155 !important;
      }
    }
  </style>
</head>
<body class="bg-dark-950 text-white min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

  <!-- Printable-Only Executive Proposal Header -->
  <div id="print-executive-header" class="hidden">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded bg-brand-600 text-white font-bold text-xs tracking-wider">TENDER PROPOSAL</span>
        <h1 class="text-base font-extrabold text-white uppercase tracking-tight">Commercial Feasibility & Cost Model</h1>
      </div>
      <p class="text-[10px] text-slate-300 mt-0.5 font-medium">Activity-Based Costing, Statutory Burden Absorption & 3Y Feasibility Schedule</p>
    </div>
    <div class="text-right text-[9.5px] font-mono text-slate-300 leading-tight">
      <div>Ref: <b class="text-brand-400">FM-BID-2026-V1.3</b></div>
      <div>Date: <b id="print-date" class="text-white"></b></div>
      <div>Status: <span class="text-emerald-400 font-bold uppercase">Commercial Baseline</span></div>
    </div>
  </div>

  <!-- Top Navigation Header (Tri-Asset Integrated Navigation) -->
  <header class="bg-dark-900 border-b border-slate-800 px-6 py-3.5 sticky top-0 z-50 flex flex-wrap items-center justify-between gap-4 shadow-xl no-print">
    <!-- Brand Title -->
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-brand-600 flex items-center justify-center font-bold text-white shadow-lg shadow-brand-500/20">
        CF
      </div>
      <div>
        <h1 class="text-base font-bold tracking-tight text-white flex items-center gap-2">
          Commercial Valuation & Tender Costing Model
          <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20">v1.3 Dynamic</span>
        </h1>
        <p class="text-xs text-slate-300">Institutional Pricing Engine, Labor Cost Engineering & 3-Year DCF Risk Simulation</p>
      </div>
    </div>
    
    <!-- Navigation Tabs & Tri-Asset Action Controls -->
    <div class="flex flex-wrap items-center gap-2.5">
      
      <!-- Interactive Tab Switcher -->
      <div class="flex bg-dark-850 p-1 rounded-lg border border-slate-800 text-xs font-medium">
        <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="px-3 py-1.5 rounded-md bg-brand-600 text-white shadow transition-all">Executive Summary</button>
        <button onclick="switchTab('pnl')" id="tab-btn-pnl" class="px-3 py-1.5 rounded-md text-slate-400 hover:text-slate-200 transition-all">3Y Financials & DCF</button>
        <button onclick="switchTab('ratecard')" id="tab-btn-ratecard" class="px-3 py-1.5 rounded-md text-slate-400 hover:text-slate-200 transition-all">Commercial Rate Card</button>
        <button onclick="switchTab('montecarlo')" id="tab-btn-montecarlo" class="px-3 py-1.5 rounded-md text-slate-400 hover:text-slate-200 transition-all">Monte Carlo Risk</button>
      </div>

      <!-- Asset Link 1: Static Executive Proposal PDF -->
      <a href="assets/Commercial_Tender_Executive_Proposal.pdf" 
         target="_blank"
         class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-200 hover:text-white bg-dark-850 hover:bg-slate-800 border border-slate-700 shadow transition">
        <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
        Executive Proposal (.pdf)
      </a>

      <!-- Asset Link 2: Sanitized Excel Financial Model Backbone -->
      <a href="assets/Commercial_Pricing_Valuation_Model_v1.3.xlsx" 
         download="Commercial_Pricing_Valuation_Model_v1.3.xlsx"
         class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-200 hover:text-white bg-dark-850 hover:bg-slate-800 border border-slate-700 shadow transition">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Cost Engine (.xlsx)
      </a>

      <!-- Asset Link 3: Dynamic Scenario PDF Print Generator -->
      <button onclick="triggerPrintProposal()" class="text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 px-3.5 py-1.5 rounded-lg border border-emerald-500/40 shadow-lg shadow-emerald-600/20 transition flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
        </svg>
        Print Scenario
      </button>

      <!-- Reset Defaults Button -->
      <button onclick="resetDefaults()" class="text-xs text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition">
        Reset
      </button>

    </div>
  </header>

  <!-- Main Container -->
  <div class="flex-1 max-w-[1600px] w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Left Control Panel (3 cols) -->
    <aside class="lg:col-span-3 space-y-5 bg-dark-900/90 backdrop-blur rounded-2xl p-5 border border-slate-800 shadow-2xl h-fit no-print">
      
      <!-- Scenario Presets Section -->
      <div class="space-y-2.5 pb-4 border-b border-slate-800">
        <span class="text-xs font-bold text-brand-400 uppercase tracking-wider block flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
          Scenario Presets
        </span>
        <div class="grid grid-cols-3 gap-1.5">
          <button onclick="applyPreset('aggressive')" id="btn-pre-aggressive" class="px-2 py-1.5 rounded-lg bg-dark-850 hover:bg-slate-800 text-[11px] font-medium text-slate-200 border border-slate-700/80 hover:text-white transition text-center leading-tight">
            Aggressive Bid
          </button>
          <button onclick="applyPreset('conservative')" id="btn-pre-conservative" class="px-2 py-1.5 rounded-lg bg-dark-850 hover:bg-slate-800 text-[11px] font-medium text-slate-200 border border-slate-700/80 hover:text-white transition text-center leading-tight">
            Conservative
          </button>
          <button onclick="applyPreset('defense')" id="btn-pre-defense" class="px-2 py-1.5 rounded-lg bg-dark-850 hover:bg-slate-800 text-[11px] font-medium text-slate-200 border border-slate-700/80 hover:text-white transition text-center leading-tight">
            Inflation Def.
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-300 flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
          Dynamic Parameters
        </h2>
        <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Reactive</span>
      </div>

      <!-- Pricing Slicer (Baseline 930,000 EGP) -->
      <div class="space-y-2">
        <div class="flex justify-between text-xs">
          <span class="text-slate-200 font-medium">Monthly Selling Price (EGP)</span>
          <span id="lbl-price" class="font-mono text-brand-400 font-semibold">930,000</span>
        </div>
        <input type="range" id="inp-price" min="500000" max="1500000" step="5000" value="930000" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
      </div>

      <!-- Headcount Slicers -->
      <div class="space-y-3 pt-2 border-t border-slate-800/80">
        <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Operational Headcount</span>
        
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Cleaners (Workers)</span>
            <span id="lbl-cleaners" class="font-mono text-white font-medium">36 (+6 Relief = 42)</span>
          </div>
          <input type="range" id="inp-cleaners" min="6" max="120" step="3" value="36" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>

        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Supervisors</span>
            <span id="lbl-supervisors" class="font-mono text-white font-medium">5 (+1 Relief = 6)</span>
          </div>
          <input type="range" id="inp-supervisors" min="1" max="20" step="1" value="5" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>

        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Site Managers</span>
            <span id="lbl-managers" class="font-mono text-white font-medium">1</span>
          </div>
          <input type="range" id="inp-managers" min="0" max="5" step="1" value="1" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>
      </div>

      <!-- Statutory & Policy Slicers -->
      <div class="space-y-3 pt-2 border-t border-slate-800/80">
        <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Burdens & Policy</span>
        
        <div>
          <label class="text-xs text-slate-200 block mb-1">Social Insurance Base</label>
          <select id="sel-insurance" class="w-full bg-dark-850 border border-slate-700 text-xs rounded-lg p-2 text-white focus:outline-none focus:border-brand-500">
            <option value="full" selected>Option 1: Full Basic Salary Level</option>
            <option value="min">Option 2: Statutory Min Cap (2,700 EGP Base)</option>
          </select>
        </div>

        <div>
          <label class="text-xs text-slate-200 block mb-1">Overhead Allocation Mode</label>
          <select id="sel-overhead" class="w-full bg-dark-850 border border-slate-700 text-xs rounded-lg p-2 text-white focus:outline-none focus:border-brand-500">
            <option value="revenue" selected>Method 1: Revenue Weighted % (EGP 35,178)</option>
            <option value="hours">Method 2: Operational Labor Hours (EGP 19,977)</option>
          </select>
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <span class="text-slate-200">24/7 Relief Coverage (+16.6%)</span>
          <input type="checkbox" id="chk-relief" checked class="w-4 h-4 text-brand-500 rounded bg-slate-800 border-slate-700 focus:ring-brand-500">
        </div>
      </div>

      <!-- Macro & Inflation Assumptions -->
      <div class="space-y-3 pt-2 border-t border-slate-800/80">
        <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Macro Assumptions (Y2+)</span>
        
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Cost Inflation Rate</span>
            <span id="lbl-inflation" class="font-mono text-amber-400 font-medium">15.0%</span>
          </div>
          <input type="range" id="inp-inflation" min="0" max="35" step="1" value="15" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>

        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Contract Escalation Rate</span>
            <span id="lbl-escalation" class="font-mono text-emerald-400 font-medium">10.0%</span>
          </div>
          <input type="range" id="inp-escalation" min="0" max="30" step="1" value="10" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>

        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="text-slate-200">Discount Rate (WACC)</span>
            <span id="lbl-wacc" class="font-mono text-purple-400 font-medium">45.75%</span>
          </div>
          <input type="range" id="inp-wacc" min="15" max="60" step="0.25" value="45.75" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
        </div>
      </div>
    </aside>

    <!-- Right Presentation Panels (9 cols) -->
    <main class="lg:col-span-9 space-y-6">

      <!-- Real-Time Top KPI Metric Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 print-kpi-grid">
        <!-- Monthly Revenue -->
        <div class="bg-dark-900 border border-slate-800 rounded-2xl p-4 shadow-lg flex flex-col justify-between relative overflow-hidden group print-kpi-card">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Monthly Revenue</span>
          <div class="mt-2">
            <span id="kpi-revenue" class="text-2xl font-bold font-mono text-white val">930,000</span>
            <span class="text-xs text-slate-300 block font-mono mt-0.5">EGP / Month</span>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] border-t border-slate-800/80 pt-2 text-slate-300">
            <span>Per Base Worker</span>
            <span id="kpi-unit-rev" class="font-mono text-white font-semibold">22,143 EGP</span>
          </div>
        </div>

        <!-- Monthly EBITDA -->
        <div class="bg-dark-900 border border-slate-800 rounded-2xl p-4 shadow-lg flex flex-col justify-between relative overflow-hidden group print-kpi-card">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Monthly EBITDA</span>
          <div class="mt-2">
            <span id="kpi-ebitda" class="text-2xl font-bold font-mono text-emerald-400 val">208,043</span>
            <span id="kpi-ebitda-sub" class="text-xs text-slate-300 block font-mono mt-0.5">EGP (22.4% Margin)</span>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] border-t border-slate-800/80 pt-2 text-slate-300">
            <span>Annual Run-rate</span>
            <span id="kpi-annual-ebitda" class="font-mono text-white font-semibold">2.50M EGP</span>
          </div>
        </div>

        <!-- Monthly Net Profit -->
        <div class="bg-dark-900 border border-slate-800 rounded-2xl p-4 shadow-lg flex flex-col justify-between relative overflow-hidden group print-kpi-card">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Net Monthly Profit</span>
          <div class="mt-2">
            <span id="kpi-net-profit" class="text-2xl font-bold font-mono text-brand-400 val">105,909</span>
            <span id="kpi-net-profit-sub" class="text-xs text-slate-300 block font-mono mt-0.5">After Tax (11.4% Net)</span>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] border-t border-slate-800/80 pt-2 text-slate-300">
            <span>Commercial Markup</span>
            <span id="kpi-markup" class="font-mono text-white font-semibold">18.9%</span>
          </div>
        </div>

        <!-- 3-Year Project Valuation (NPV / IRR) -->
        <div class="bg-dark-900 border border-slate-800 rounded-2xl p-4 shadow-lg flex flex-col justify-between relative overflow-hidden group print-kpi-card">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">3-Year Project NPV</span>
          <div class="mt-2">
            <span id="kpi-npv" class="text-2xl font-bold font-mono text-purple-400 val">539,922</span>
            <span class="text-xs text-slate-300 block font-mono mt-0.5">EGP (IRR: <span id="kpi-irr" class="text-purple-300 font-bold">65.3%</span>)</span>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] border-t border-slate-800/80 pt-2 text-slate-300">
            <span>Payback Period</span>
            <span id="kpi-payback" class="font-mono text-white font-semibold">26.5 Months</span>
          </div>
        </div>
      </div>

      <!-- TAB 1: EXECUTIVE DASHBOARD -->
      <section id="pane-dashboard" class="space-y-6">
