    function runMonteCarlo() {
      const { cf1, cf2, cf3, capex, wacc } = currentModelState;
      const meanCF = (cf1 + cf2 + cf3) / 3.0;
      const sdCF = meanCF * 0.18;
      const runs = 1000;
      const npvResults = [];

      for (let i = 0; i < runs; i++) {
        const u1 = Math.random() || 0.0001, u2 = Math.random();
        const u3 = Math.random() || 0.0001, u4 = Math.random();
        const u5 = Math.random() || 0.0001, u6 = Math.random();

        const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
        const z1 = Math.sqrt(-2.0 * Math.log(u3)) * Math.cos(2.0 * Math.PI * u4);
        const z2 = Math.sqrt(-2.0 * Math.log(u5)) * Math.cos(2.0 * Math.PI * u6);
        
        const simCF1 = meanCF + z0 * sdCF;
        const simCF2 = meanCF + z1 * sdCF;
        const simCF3 = meanCF + z2 * sdCF;

        const simNPV = -capex + simCF1 / (1 + wacc) + simCF2 / Math.pow(1 + wacc, 2) + simCF3 / Math.pow(1 + wacc, 3);
        npvResults.push(simNPV);
      }

      npvResults.sort((a, b) => a - b);
      const meanNPV = npvResults.reduce((a, b) => a + b, 0) / runs;
      const p50NPV = npvResults[Math.floor(runs * 0.50)];
      const p05NPV = npvResults[Math.floor(runs * 0.05)];
      const losses = npvResults.filter(v => v < 0).length;

      document.getElementById('mc-mean-npv').innerText = fmtM(meanNPV) + ' EGP';
      document.getElementById('mc-p50-npv').innerText = fmtM(p50NPV) + ' EGP';
      document.getElementById('mc-var-npv').innerText = fmtM(p05NPV) + ' EGP';
      document.getElementById('mc-loss-prob').innerText = ((losses / runs) * 100).toFixed(2) + '%';

      const numBins = 25;
      const minVal = npvResults[0];
      const maxVal = npvResults[runs-1];
      const binWidth = (maxVal - minVal) / numBins;
      const bins = Array(numBins).fill(0);
      const binLabels = [];

      for (let b = 0; b < numBins; b++) {
        binLabels.push(fmtM(minVal + b * binWidth));
      }

      npvResults.forEach(v => {
        const binIdx = Math.min(numBins - 1, Math.floor((v - minVal) / binWidth));
        bins[binIdx]++;
      });

      if (chartMC) chartMC.destroy();
      const ctxMC = document.getElementById('chartMonteCarlo').getContext('2d');
      chartMC = new Chart(ctxMC, {
        type: 'bar',
        data: {
          labels: binLabels,
          datasets: [{
            label: 'Simulated NPV Frequency (1,000 Iterations)',
            data: bins,
            backgroundColor: bins.map((_, i) => (minVal + i * binWidth < 0) ? '#ef4444' : '#0ea5e9'),
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top', labels: { color: '#cbd5e1', font: { family: 'Inter', size: 11 } } },
            tooltip: { callbacks: { label: (c) => ` Frequency: ${c.raw} runs` } }
          },
          scales: {
            x: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8', font: { family: 'JetBrains Mono', size: 9 }, maxRotation: 45 } },
            y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } }
          }
        }
      });
    }

    function switchTab(tabId) {
      ['dashboard', 'pnl', 'ratecard', 'montecarlo'].forEach(t => {
        document.getElementById(`pane-${t}`).classList.add('hidden');
        document.getElementById(`tab-btn-${t}`).className = "px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition-all";
      });
      document.getElementById(`pane-${tabId}`).classList.remove('hidden');
      document.getElementById(`tab-btn-${tabId}`).className = "px-3 py-1.5 rounded-md bg-brand-600 text-white shadow transition-all";
      
      if (tabId === 'montecarlo') {
        runMonteCarlo();
      }
    }

    function resetDefaults() {
      document.getElementById('inp-price').value = 930000;
      document.getElementById('inp-cleaners').value = 36;
      document.getElementById('inp-supervisors').value = 5;
      document.getElementById('inp-managers').value = 1;
      document.getElementById('chk-relief').checked = true;
      document.getElementById('sel-insurance').value = 'full';
      document.getElementById('sel-overhead').value = 'revenue';
      document.getElementById('inp-inflation').value = 15;
      document.getElementById('inp-escalation').value = 10;
      document.getElementById('inp-wacc').value = 45.75;
      
      ['aggressive', 'conservative', 'defense'].forEach(p => {
        document.getElementById(`btn-pre-${p}`).className = "px-2 py-1.5 rounded-lg bg-dark-850 hover:bg-slate-800 text-[11px] font-medium text-slate-200 border border-slate-700/80 hover:text-white transition text-center leading-tight";
      });

      calculateModel();
    }

    ['inp-price', 'inp-cleaners', 'inp-supervisors', 'inp-managers', 'chk-relief', 'sel-insurance', 'sel-overhead', 'inp-inflation', 'inp-escalation', 'inp-wacc']
      .forEach(id => {
        document.getElementById(id).addEventListener('input', calculateModel);
      });

    window.addEventListener('DOMContentLoaded', () => {
      calculateModel();
    });
  </script>
</body>
</html>
