      document.getElementById('lbl-managers').innerText = `${reqManagers}`;
      document.getElementById('lbl-inflation').innerText = (costInflation * 100).toFixed(1) + '%';
      document.getElementById('lbl-escalation').innerText = (priceEscalation * 100).toFixed(1) + '%';
      document.getElementById('lbl-wacc').innerText = (wacc * 100).toFixed(2) + '%';
      document.getElementById('val-esc-badge').innerText = (priceEscalation * 100).toFixed(0) + '%';
      document.getElementById('val-inf-badge').innerText = (costInflation * 100).toFixed(0) + '%';

      const isFull = (insMode === 'full');
      
      const wGross = isFull ? BASELINE.workerGrossFull : BASELINE.workerGrossMin;
      const wInsCo = isFull ? BASELINE.workerInsCompanyFull : BASELINE.workerInsCompanyMin;
      const workerUnitCost = wGross + wInsCo + BASELINE.workerHealth + BASELINE.workerUniform;
      const totalWorkerCost = totCleaners * workerUnitCost;

      const sGross = isFull ? BASELINE.supGrossFull : BASELINE.supGrossMin;
      const sInsCo = isFull ? BASELINE.supInsCompanyFull : BASELINE.supInsCompanyMin;
      const supUnitCost = sGross + sInsCo + BASELINE.supHealth + BASELINE.supUniform;
      const totalSupCost = totSupervisors * supUnitCost;

      const mGross = isFull ? BASELINE.mgrGrossFull : BASELINE.mgrGrossMin;
      const mInsCo = isFull ? BASELINE.mgrInsCompanyFull : BASELINE.mgrInsCompanyMin;
      const mgrUnitCost = mGross + mInsCo + BASELINE.mgrHealth + BASELINE.mgrUniform;
      const totalMgrCost = totManagers * mgrUnitCost;

      const totalLaborCost = totalWorkerCost + totalSupCost + totalMgrCost;

      const scaleRatio = totCleaners / 42.0;
      const transCost = BASELINE.transportationSupplier * scaleRatio;
      const machDeprec = BASELINE.machineryDeprecMonthly;
      const machMaint = BASELINE.machineryMaintMonthly;
      const consumables = BASELINE.consumablesMonthly * scaleRatio;
      const directCosts = totalLaborCost + transCost + machDeprec + machMaint + consumables;

      const overheadCost = (ohMode === 'revenue') ? (BASELINE.ohRevMonthly * (price / 931000.0)) : (BASELINE.ohHoursMonthly * scaleRatio);
      const totalCostMonthly = directCosts + overheadCost;

      const cashExpensesMonthly = totalLaborCost + transCost + consumables + machMaint + overheadCost;
      const ebitdaMonthly = price - cashExpensesMonthly;
      const ebtMonthly = price - totalCostMonthly;
      const taxMonthly = (price * BASELINE.taxableProfitFactor) * BASELINE.corporateTaxRate;
      const netProfitMonthly = ebtMonthly - taxMonthly;

      const markupPct = ((price - totalCostMonthly) / totalCostMonthly) * 100;
      const netMarginPct = (netProfitMonthly / price) * 100;
      const ebitdaMarginPct = (ebitdaMonthly / price) * 100;

      const fixedCostsMonthly = machDeprec + machMaint + transCost + consumables + overheadCost;
      const varCostPerWorker = totalLaborCost / baseHeadcount;
      const revPerWorker = price / baseHeadcount;
      const contribMarginPerWorker = revPerWorker - varCostPerWorker;
      const bepWorkers = contribMarginPerWorker > 0 ? (fixedCostsMonthly / contribMarginPerWorker) : 0;

      const yr1Rev = price * 12;
      const yr2Rev = yr1Rev * (1 + priceEscalation);
      const yr3Rev = yr2Rev * (1 + priceEscalation);

      const yr1CashExpenses = cashExpensesMonthly * 12;
      const yr2CashExpenses = yr1CashExpenses * (1 + costInflation);
      const yr3CashExpenses = yr2CashExpenses * (1 + costInflation);

      const yr1Deprec = machDeprec * 12;
      const yr2Deprec = machDeprec * 12;
      const yr3Deprec = machDeprec * 12;

      const yr1Ebitda = yr1Rev - yr1CashExpenses;
      const yr2Ebitda = yr2Rev - yr2CashExpenses;
      const yr3Ebitda = yr3Rev - yr3CashExpenses;

      const yr1Tax = (yr1Rev * BASELINE.taxableProfitFactor) * BASELINE.corporateTaxRate;
      const yr2Tax = (yr2Rev * BASELINE.taxableProfitFactor) * BASELINE.corporateTaxRate;
      const yr3Tax = (yr3Rev * BASELINE.taxableProfitFactor) * BASELINE.corporateTaxRate;

      const wc1 = (price - totalLaborCost - transCost - consumables);
      const wc2 = (price * (1 + priceEscalation) - (totalLaborCost + transCost + consumables) * (1 + costInflation));
      const wc3 = (price * Math.pow(1 + priceEscalation, 2) - (totalLaborCost + transCost + consumables) * Math.pow(1 + costInflation, 2));

      const dWC1 = wc1;
      const dWC2 = wc2 - wc1;
      const dWC3 = wc3 - wc2;

      const cf0 = -BASELINE.machineryCapex;
      const cf1 = yr1Ebitda - yr1Tax - dWC1;
      const cf2 = yr2Ebitda - yr2Tax - dWC2;
      const salvageVal = BASELINE.machineryCapex * BASELINE.salvageRate;
      const cf3 = yr3Ebitda - yr3Tax - dWC3 + salvageVal;

      currentModelState = { cf1, cf2, cf3, capex: BASELINE.machineryCapex, wacc };

      const pv1 = cf1 / Math.pow(1 + wacc, 1);
      const pv2 = cf2 / Math.pow(1 + wacc, 2);
      const pv3 = cf3 / Math.pow(1 + wacc, 3);
      const npv = cf0 + pv1 + pv2 + pv3;

      let irr = 0.50;
      for (let iter = 0; iter < 100; iter++) {
        const npvVal = cf0 + cf1/(1+irr) + cf2/Math.pow(1+irr, 2) + cf3/Math.pow(1+irr, 3);
        const dNpv = -cf1/Math.pow(1+irr, 2) - 2*cf2/Math.pow(1+irr, 3) - 3*cf3/Math.pow(1+irr, 4);
        const nextIrr = irr - npvVal / dNpv;
        if (Math.abs(nextIrr - irr) < 0.00001) { irr = nextIrr; break; }
        irr = nextIrr;
      }

      let paybackMonths = 36;
      if (cf0 + pv1 >= 0) {
        paybackMonths = (Math.abs(cf0) / pv1) * 12;
      } else if (cf0 + pv1 + pv2 >= 0) {
        paybackMonths = 12 + ((Math.abs(cf0) - pv1) / pv2) * 12;
      } else if (cf0 + pv1 + pv2 + pv3 >= 0) {
        paybackMonths = 24 + ((Math.abs(cf0) - pv1 - pv2) / pv3) * 12;
      }

      document.getElementById('kpi-revenue').innerText = fmt(price);
      document.getElementById('kpi-unit-rev').innerText = fmt(price / baseHeadcount) + ' EGP';
      document.getElementById('kpi-ebitda').innerText = fmt(ebitdaMonthly);
      document.getElementById('kpi-ebitda-sub').innerText = `EGP (${fmtDec(ebitdaMarginPct)}% Margin)`;
      document.getElementById('kpi-annual-ebitda').innerText = fmtM(ebitdaMonthly * 12) + ' EGP';
      document.getElementById('kpi-net-profit').innerText = fmt(netProfitMonthly);
      document.getElementById('kpi-net-profit-sub').innerText = `After Tax (${fmtDec(netMarginPct)}% Net)`;
      document.getElementById('kpi-markup').innerText = fmtDec(markupPct) + '%';
      document.getElementById('kpi-npv').innerText = fmt(npv);
      document.getElementById('kpi-irr').innerText = fmtDec(irr * 100) + '%';
      document.getElementById('kpi-payback').innerText = fmtDec(paybackMonths, 1) + ' Months';
      document.getElementById('lbl-total-cost').innerText = `Total: ${fmt(totalCostMonthly)} EGP`;
      document.getElementById('lbl-bep-workers').innerText = `BEP: ${fmtDec(bepWorkers, 1)} Workers`;

      renderCostTable({
        totalLaborCost, transCost, machDeprec, machMaint, consumables, overheadCost, totalCostMonthly, totalHeadcount
      });

      renderMultiYearTable({
        yr1Rev, yr2Rev, yr3Rev,
        yr1CashExpenses, yr2CashExpenses, yr3CashExpenses,
        yr1Deprec, yr2Deprec, yr3Deprec,
        yr1Ebitda, yr2Ebitda, yr3Ebitda,
        yr1Tax, yr2Tax, yr3Tax,
        cf0, cf1, cf2, cf3, salvageVal, npv
      });

      renderRateCards({
        price, totalCostMonthly, markupPct, netMarginPct,
        totalWorkerCost, totalSupCost, totalMgrCost,
        reqCleaners, reqSupervisors, reqManagers, baseHeadcount,
        totalLaborCost, transCost, machDeprec, machMaint, consumables, overheadCost, taxMonthly, fixedCostsMonthly
      });

      updateCharts({
        totalLaborCost, transCost, machDeprec, machMaint, consumables, overheadCost,
        price, bepWorkers, fixedCostsMonthly, varCostPerWorker, revPerWorker, baseHeadcount,
        yr1Rev, yr2Rev, yr3Rev, yr1CashExpenses, yr2CashExpenses, yr3CashExpenses, yr1Ebitda, yr2Ebitda, yr3Ebitda
      });

      if (!document.getElementById('pane-montecarlo').classList.contains('hidden')) {
        runMonteCarlo();
      }
    }

